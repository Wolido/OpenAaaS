# OpenAaaS Agent Core 配置文件示例
# 复制此文件为 config.toml 并根据需要修改

[server]
# Server 地址
base_url = "http://127.0.0.1:8080"
# 轮询间隔（秒）
poll_interval_secs = 5
# 是否使用系统代理（true = 使用系统代理，false = 禁用）
use_system_proxy = false

[agent]
# 服务 ID（注册后自动填充，无需手动设置）
# service_id = "svc-xxx"
# API Key（注册后自动填充，无需手动设置）
# api_key = "ak_xxx"
# Agent 名称
name = "agent-core"

[executor]
# 执行器类型：standard / bash / python / custom
executor_type = "standard"
# Docker 镜像
image = "open-aaas-executor:latest"
# 并发任务数
capacity = 2
# 任务超时时间（分钟），0 表示不限制
timeout_minutes = 0
# 内存限制（可选）
# memory_limit = "4g"
# 工作目录（容器内）
working_dir = "/workspace"
# 脚本路径（仅 bash / python 类型使用）
# script_path = "/workspace/run.sh"
# 自定义 ENTRYPOINT（仅 custom 类型使用）
# custom_entrypoint = ["/bin/sh", "-c"]
# 自定义命令参数（仅 custom 类型使用）
# custom_args = ["echo", "hello"]
# 是否允许任务容器访问宿主机服务（可选，true = 注入 host.docker.internal 指向宿主机）
# 安全风险：开启后任务容器可访问宿主机上监听 0.0.0.0 的所有服务，请谨慎开启
# 提示：Docker Desktop（macOS / Windows）与 OrbStack 等桌面运行时已内置 host.docker.internal 解析，开启此功能冗余但无害；仅 Linux 原生 Docker Engine 需要开启
# enable_host_access = false
# GPU 挂载（可选，v1 仅支持 nvidia；amd / intel 预留，默认关闭）
# 安全风险：开启后所有任务容器都获得 GPU 访问权（docker --gpus 参数挂载），仅建议管理员显式开启
# 平台要求：仅 Linux / WSL2 支持（Linux 需安装 nvidia-container-toolkit）；macOS 与 Windows 原生不支持，配置了会启动报错
# 开启示例（devices 为 "all" 挂载全部 GPU，也可按索引指定如 "0,1"）：
# 注意：devices 仅支持 "all" 或逗号分隔的数字索引（空白按 "all" 处理）；含空格、分号、字母或空段（如 "0;;1"）的非法值会配置加载报错、拒绝启动
# gpu.vendor = "nvidia"
# gpu.devices = "all"

[paths]
# 数据目录
data_dir = "./data"

# 挂载配置（可选）
# [[paths.mounts]]
# host = "./share/kimi-config"
# container = "/shared/kimi-config"
# readonly = true
