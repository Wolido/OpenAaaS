{
  "name": "open-aaas-pi-extension",
  "version": "1.2.0",
  "description": "OpenAaaS pi extension",
  "license": "MIT",
  "author": "IDM Explorer Lab",
  "homepage": "https://github.com/Wolido/OpenAaaS/tree/main/pi-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolido/OpenAaaS.git"
  },
  "bugs": {
    "url": "https://github.com/Wolido/OpenAaaS/issues"
  },
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "files": [
    "index.ts",
    "polling.ts",
    "result-notify.ts",
    "README.md",
